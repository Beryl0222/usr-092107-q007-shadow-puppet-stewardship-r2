{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "皮影剧团藏用协同台领域事件",
  "description": "所有变化以事件追加；标识、发生时间与版本不得原地改写，更正使用新的后继记录。事件目录见 README。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "OBJECT_CLASSIFIED",
        "COMPONENT_REGISTERED",
        "CONDITION_ASSESSED",
        "REPAIR_DOCUMENTED",
        "REPLICA_DESIGNATED",
        "SCRIPT_VERSION_CREATED",
        "LYRICS_APPROVED",
        "OCCASION_APPROVED",
        "ROLE_DEFINED",
        "PERSON_REGISTERED",
        "ROLE_QUALIFICATION_GRANTED",
        "ACCOMPANIMENT_QUALIFICATION_GRANTED",
        "MEMBER_STATUS_CHANGED",
        "INSTRUMENT_REGISTERED",
        "INSTRUMENT_STATUS_CHANGED",
        "PROGRAM_MIN_STAFF_DEFINED",
        "VENUE_CONDITIONS_RECORDED",
        "ROSTER_CONFIRMED",
        "TRIP_PLAN_ISSUED",
        "OBJECT_CHECKED_OUT",
        "OBJECT_RETURNED",
        "PERFORMANCE_LOGGED",
        "PUBLIC_PROFILE_PUBLISHED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "puppet_object",
        "repertoire_version",
        "performance_roster",
        "loan_handoff",
        "role",
        "person",
        "instrument",
        "program",
        "venue",
        "trip"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "description": "事件的具体字段，随事件类型由应用层校验；合同层保持开放。"
    }
  },
  "additionalProperties": true
}
