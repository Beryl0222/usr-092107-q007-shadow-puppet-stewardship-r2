{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "皮影剧团藏用协同台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "OBJECT_CLASSIFIED",
        "REPAIR_DOCUMENTED",
        "ROSTER_CONFIRMED",
        "OBJECT_CHECKED_OUT",
        "PERFORMANCE_LOGGED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "puppet_object",
        "repertoire_version",
        "performance_roster",
        "loan_handoff"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
